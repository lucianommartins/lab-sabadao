# Copy this file to deploy/.env and fill in your own deployment.
#
# deploy/.env is matched by the `.env` rule in .gitignore, so your copy stays
# local. deploy.sh sources it automatically, so `./deploy/deploy.sh` needs no
# exports once this file exists.
#
# The `:=` form assigns only when the variable is unset or empty, so anything
# already in the environment wins. That keeps one-off overrides working:
#   GCP_REGION=europe-west4 ./deploy/deploy.sh
#
# GCP_PROJECT and GBENCH_TF_STATE_BUCKET have no default anywhere and deploy.sh
# refuses to run without them. GCP_REGION already defaults to us-central1.

: "${GCP_PROJECT:=your-project-id}"
: "${GBENCH_TF_STATE_BUCKET:=your-terraform-state-bucket}"
: "${GCP_REGION:=us-central1}"
